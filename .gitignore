# ESP-IDF build output (regenerated by `idf.py build`)
build/

# Full config is generated from sdkconfig.defaults (committed) on first build
sdkconfig
sdkconfig.old

# Which firmware mode to build (written by tools/pick_mode.py, local to each person)
main/mode_select.h

# ESP-IDF component manager downloads (re-fetched from idf_component.yml).
# dependencies.lock IS committed so everyone gets the same library versions.
managed_components/

# Compiled artifacts
*.o
*.a
*.bin
*.elf
*.map

# Editor / machine-specific settings (local paths, COM port)
.vscode/
.clangd/
.cache/
compile_commands.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Temp / logs
*~
*.swp
*.tmp
*.bak
*.log
